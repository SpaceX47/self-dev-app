# ===========================================================================
# Environment Variables - Self-Development App (Docker Compose)
# ===========================================================================
# คัดลอกไฟล์นี้เป็น .env:   cp .env.example .env
# แล้วแก้ไขค่าตามต้องการ
# ===========================================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=self_dev_db
DB_PORT=5432

# --- FastAPI ---
API_PORT=8000
APP_ENV=production

# --- Google AI (Gemini Vision) ---
GOOGLE_API_KEY=your_google_api_key_here
