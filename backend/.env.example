# ===========================================================================
# Environment Variables - Self-Development App
# ===========================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
# cp .env.example .env
# ===========================================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/self_dev_db

# --- Google AI (Gemini Vision) ---
GOOGLE_API_KEY=your_google_api_key_here

# --- Application ---
APP_ENV=development
APP_PORT=8000
